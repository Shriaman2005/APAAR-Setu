# APAAR Setu - environment configuration (copy to .env and fill in).
# NEVER commit the real .env file. Values below are placeholders or safe local defaults.

NODE_ENV=development
PORT=5000

# MongoDB MUST be a replica set (or Atlas) for certification transactions.
# "npm run db:dev" starts a local single-node replica set and prints this exact URI.
MONGODB_URI=mongodb://127.0.0.1:27017/apaar_setu_dev?replicaSet=rs0

# Long random string (32+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace_with_long_random_secret

# Optional: separate secret for the keyed checksum inside credential/QR references.
# If empty, a value is derived from SESSION_SECRET (changing it invalidates existing QR codes).
CREDENTIAL_REF_SECRET=

# Where the React app runs (used for CORS and for activation/reset links).
# On Render leave this and PUBLIC_VERIFY_BASE_URL unset: RENDER_EXTERNAL_URL is used instead.
CLIENT_ORIGIN=http://localhost:5173
# Base URL encoded into QR codes for the public verification page.
PUBLIC_VERIFY_BASE_URL=http://localhost:5173

# Proposed demo defaults (spec 02 section 5) - not official policy or proven capacity limits.
SESSION_MAX_AGE_MS=3600000
MAX_UPLOAD_MB=5
MAX_ROWS_PER_BATCH=10000

# Validation runs in the background after upload ("async"). Tests use "sync".
VALIDATION_MODE=async

# Optional: one shared password for all seeded DEMO accounts (development only, 12+ chars with
# letters and digits). Leave empty to have "npm run seed" generate random passwords and print them once.
DEMO_PASSWORD=

# "Quick demo access" on the sign-in page: one click signs in to a seeded demo account (no password).
# On by default in development, off by default when NODE_ENV=production. Prototype demos only.
# DEMO_LOGIN=true

# Production-only settings
# COOKIE_SECURE=true        # send the session cookie over HTTPS only (default true in production)
# TRUST_PROXY=1             # set when running behind a reverse proxy / load balancer
# SERVE_CLIENT=true         # serve client/dist from Express (default true in production)
